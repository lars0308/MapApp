{
  "name": "mapforge",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "MapForge – prozeduraler 2D-Map-Generator und Tile-Editor für Pixelart-Spiele mit Godot-4-Export",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc -b --noEmit",
    "prebuild": "node scripts/sync-spec.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@supabase/supabase-js": "^2.117.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "~5.9.3",
    "vite": "^8.3.0"
  },
  "engines": {
    "node": ">=20.19"
  }
}
