{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "functions": {
    "api/cloud.js": {
      "maxDuration": 150,
      "memory": 2048,
      "includeFiles": "node_modules/@sparticuz/chromium/bin/**"
    },
    "api/describe.js": {
      "maxDuration": 120
    },
    "api/agent.js": {
      "maxDuration": 300,
      "includeFiles": "src/api/spec.json"
    }
  }
}
